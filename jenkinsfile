pipeline {
    agent any

    stages {
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t flask-demo:v1 .'
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                docker rm -f flask-demo || true
                docker run -d --name flask-demo -p 5000:5000 flask-demo:v1
                '''
            }
        }
    }
}
